{
  "name": "checkout-and-reward-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/cli.ts seed",
    "test": "vitest run tests/setup.test.ts",
    "test:watch": "vitest tests/setup.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run tests/database.test.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "knex": "3.3.0",
    "pg": "8.23.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
